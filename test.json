{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Malaysia - Poverty (2022)",
  "width": 950,
  "height": 750,
  "data": {
    "url": "https://raw.githubusercontent.com/jamierajem/malaysia-map-visualisation/refs/heads/main/malaysia_map_graticule.json",
    "format": {"type": "topojson", "feature": "my"}
  },
  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/jamierajem/malaysia-map-visualisation/refs/heads/main/hh_poverty_state_clean.csv",
          "format": {"type": "csv"}
        },
        "key": "state",
        "fields": ["poverty_absolute"]
      }
    },
    {
      "calculate": "replace(datum.properties.name, 'W.P. ', '')",
      "as": "state_norm"
    },
    {
      "lookup": "state_norm",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/jamierajem/malaysia-map-visualisation/refs/heads/main/hh_poverty_state_clean.csv",
          "format": {"type": "csv"}
        },
        "key": "state",
        "fields": ["poverty_absolute"]
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [110, 4],
    "scale": 2500
  },
  "layer": [
    {
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
          "field": "poverty_absolute",
          "type": "quantitative",
          "title": "Poverty (absolute)",
          "scale": {"scheme": "purples"}
        },
        "tooltip": [
          {"field": "properties.name", "title": "State"},
          {"field": "poverty_absolute", "title": "Poverty (absolute)"}
        ]
      }
    },
    {
      "data": {
        "graticule": {
          "step": [2, 2],
          "extent": [[90, -10], [125, 10]]
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "gray",
        "strokeWidth": 0.5,
        "opacity": 0.5
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 116.5,
            "latitude": 6.0,
            "note": "Sabah has the highest poverty rate (19.7%) in 2022"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -80,
        "dy": -5,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#4B0082"
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "note"}
      }
    },
    {
      "data": {
        "values": [{"longitude": 117.0, "latitude": 5.5}]
      },
      "mark": {
        "type": "point",
        "color": "#4B0082",
        "size": 60
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"}
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "background": "white"
  }
}
